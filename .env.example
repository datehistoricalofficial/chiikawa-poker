# 胡地 (Alakazam) — 環境變數設定
# 複製這個檔案為 .env 並填入你的資訊：
#   cp .env.example .env

# Telegram Bot Token
# 1. 在 Telegram 搜尋 @BotFather
# 2. 輸入 /newbot，照指示建立 bot
# 3. 把拿到的 token 貼在這裡
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID（你的個人 chat id）
# 1. 在 Telegram 搜尋 @userinfobot
# 2. 傳任何訊息給它，它會回覆你的 id
# 3. 把數字貼在這裡（例如：123456789）
TELEGRAM_CHAT_ID=your_chat_id_here
